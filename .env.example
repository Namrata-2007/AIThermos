# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# ==========================================================
# AI FIRE ONE - SIH 2026 (NTRO Problem Statement 162)
# ==========================================================

# NASA FIRMS API Configuration (Near-Real-Time Satellite Thermal Data)
# Get your free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=""
FIRMS_MAP_KEY=""
FIRMS_SOURCE="VIIRS_NOAA21_NRT"
FIRMS_DAYS="1"

# Global Camera / Webcam API Provider (Windy / EarthCam / Custom Stream Aggregator)
GLOBAL_WEBCAM_API_KEY=""

# Twilio Emergency Voice Call & SMS API
# Get credentials at https://www.twilio.com/console
TELEPHONY_MODE="TEST"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# PostgreSQL + PostGIS Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aifireone"

# OpenStreetMap Overpass Public API Endpoint
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# Operational Mode Toggles
DEMO_MODE=true
SIMULATED_DISPATCH_REGISTRY=true
